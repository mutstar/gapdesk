[Unit]
Description=Gapdesk 30-second public market collector
Wants=network-online.target
After=network-online.target

[Service]
User=gapdesk
Group=gapdesk
WorkingDirectory=/opt/gapdesk/collector
LoadCredentialEncrypted=sites-token:/etc/credstore.encrypted/gapdesk-sites-token
ExecStart=/bin/sh -c 'exec /usr/bin/node /opt/gapdesk/collector/scripts/public-market-monitor.mjs < "$$CREDENTIALS_DIRECTORY/sites-token"'
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gapdesk/collector

[Install]
WantedBy=multi-user.target
