{
    admin off
}

gapdesk.example.com {
    basicauth {
        {$GAPDESK_LOGIN} {$GAPDESK_PASSWORD_HASH}
    }
    header {
        Strict-Transport-Security "max-age=86400"
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    encode gzip
    reverse_proxy unix//run/gapdesk-web/gateway.sock {
        header_up -Authorization
        flush_interval -1
    }
}
